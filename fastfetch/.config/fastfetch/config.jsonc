{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch-logo.txt",
    "padding": {
      "top": 0,
      "right": 4
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;36m󰣇  {user-name}@{host-name}\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[90m╭─\u001b[0m \u001b[1;36m󰍛 SYSTEM\u001b[0m \u001b[90m──────────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "os",
      "key": "\u001b[90m󰣇  OS\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m󰒋  Kernel\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[90m󰌢  Device\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m󰔛  Uptime\u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[90m󰏖  Packages\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[90m├─\u001b[0m \u001b[1;36m󰧨 DESKTOP\u001b[0m \u001b[90m─────────────────────────────────────┤\u001b[0m"
    },

    {
      "type": "shell",
      "key": "\u001b[90m  Shell\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m󰆍  Terminal\u001b[0m"
    },
    {
      "type": "de",
      "key": "\u001b[90m󰇄  Desktop\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[90m󰖲  Session\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[90m├─\u001b[0m \u001b[1;36m󰍛 HARDWARE\u001b[0m \u001b[90m────────────────────────────────────┤\u001b[0m"
    },

    {
      "type": "cpu",
      "key": "\u001b[90m󰻠  CPU\u001b[0m"
    },
    {
      "type": "gpu",
      "key": "\u001b[90m󰢮  GPU\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[90m󰍛  Memory\u001b[0m"
    },
    {
      "type": "disk",
      "key": "\u001b[90m󰋊  Disk\u001b[0m",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "\u001b[90m󰁹  Battery\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
